{
  "schemaVersion": 1,
  "id": "waypointmenu",
  "version": "${version}",
  "name": "Waypoint Menu",
  "description": "Record locations, attach a set of commands to each one, and highlight them in the world from a list.",
  "authors": [
    "waypointmenu"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/waypointmenu/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.waypointmenu.WaypointMenuClient"
    ],
    "modmenu": [
      "com.waypointmenu.compat.ModMenuIntegration"
    ]
  },
  "mixins": [
    "waypointmenu.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
